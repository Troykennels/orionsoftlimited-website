VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=

# Optional form override. Leave empty when using the built-in Vercel /api/forms endpoint.
VITE_ORIONSOFT_FORM_ENDPOINT=
RESEND_API_KEY=
FORM_TO_EMAIL=orionsoftlimited@gmail.com
FORM_FROM_EMAIL=Orion Soft Website <hello@orionsoftlimited.com>

# Transactional email — nodemailer/Gmail is tried first, falls back to Resend above.
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_FROM_EMAIL=Orion Soft <onboarding@resend.dev>
ADMIN_EMAIL=orionsoftlimited@gmail.com

# Upstash Redis REST (Vercel KV or direct Upstash) — required for leads, analytics,
# contracts, employees, payroll, and every other server-persisted record.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Admin & staff auth (required) ---
# Long random string used to sign session cookies. Generate with e.g.
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
SESSION_SECRET=
# One-time secret used only to call POST /api/auth/bootstrap-admin and create the
# first real admin account (or additional ones later). Keep this private — never
# expose it in client code. Also generate with the command above.
ADMIN_SECRET=

# --- Paystack (required for payments) ---
PAYSTACK_SECRET_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

# Absolute production URL — used to build links inside transactional emails
# (contract sign links, payment callback, payslip links).
APP_BASE_URL=https://orionsoftlimited.com
